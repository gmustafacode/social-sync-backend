# ==============================================================================
# MY FYP PROJECT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

PORT=8000
FRONTEND_URL=https://myfrontend-bice.vercel.app

# Database (MongoDB Mongoose Connection URI)
MONGO_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority"

# Authentication & Security
JWT_SECRET="your_jwt_secret_key_here_minimum_32_characters"
# AES-256-GCM Encryption Key for OAuth Tokens (MUST be exactly 32 characters)
ENCRYPTION_KEY="your_32_character_encryption_key"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_key"

# Webhook Security & Automation
WEBHOOK_SECRET="your_webhook_secret_key"
N8N_PUBLISH_WEBHOOK_URL="https://your-n8n-instance.com/webhook/publish"

# Inngest Background Automation
INNGEST_EVENT_KEY="your_inngest_event_key"
INNGEST_SIGNING_KEY_FALLBACK="your_inngest_signing_key"

# Social Authentication Providers (Google & GitHub)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# Email Delivery (Resend API)
RESEND_API_KEY="your_resend_api_key"

# AI Configuration (Groq Llama 3.3 & OpenAI)
GROQ_API_KEY="your_groq_api_key"
OPENAI_API_KEY="your_openai_api_key"

# Content Ingestion & Media Connectors
NEWS_API_KEY="your_news_api_key"
UNSPLASH_APP_ID="your_unsplash_app_id"
UNSPLASH_ACCESS_KEY="your_unsplash_access_key"
UNSPLASH_SECRET_KEY="your_unsplash_secret_key"
PEXELS_API_KEY="your_pexels_api_key"

# LinkedIn (OAuth 2.0)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"
LINKEDIN_REDIRECT_URI=https://newproject-chi-gold.vercel.app/api/social/linkedin/callback

# X / Twitter (OAuth 2.0 PKCE)
X_CLIENT_ID="your_x_client_id"
X_CLIENT_SECRET="your_x_client_secret"
X_CALLBACK_URL=https://newproject-chi-gold.vercel.app/api/social/x/callback

# Facebook (Graph API v25.0)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=https://newproject-chi-gold.vercel.app/api/social/facebook/callback
FACEBOOK_MOBILE_REDIRECT_URI=https://newproject-chi-gold.vercel.app/api/social/facebook/callback
FACEBOOK_API_VERSION=v25.0

# Instagram (Graph API v25.0)
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=https://newproject-chi-gold.vercel.app/api/social/instagram/callback
INSTAGRAM_API_VERSION=v25.0
